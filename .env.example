# Copy to .env (gitignored) and fill in a real key.
# `make repair-*` loads .env from the repo root and exports these variables.
REPAIR_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
# deepseek-reasoner is also supported; it uses the JSON-only fallback.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=180
